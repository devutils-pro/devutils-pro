#!/usr/bin/env python3
"""
DevUtils Pro — Master Command
Run any DevUtils tool from a single entry point.

Usage:
  ./devutils organize ~/Downloads --analyze
  ./devutils csvkit data.csv --stats
  ./devutils jsonkit config.json --validate
  ./devutils logscan server.log --errors
  ./devutils renamer *.jpg --prefix "img_" --execute
"""

import sys
import subprocess
from pathlib import Path

TOOLS = {
    "organize": "organize.py",
    "csvkit": "csvkit.py",
    "jsonkit": "jsonkit.py",
    "logscan": "logscan.py",
    "renamer": "renamer.py",
}

def main():
    if len(sys.argv) < 2:
        print("🔧 DevUtils Pro — 5 CLI tools for developers")
        print()
        print("Usage: ./devutils <tool> [args...]")
        print()
        print("Tools:")
        for name, script in TOOLS.items():
            print(f"  {name:12s} — {script}")
        print()
        print("Example:")
        print("  ./devutils organize ~/Downloads --analyze")
        print("  ./devutils csvkit data.csv --stats")
        print()
        print("Get all 5 tools: https://[gumroad-link] — Only $7")
        sys.exit(0)
    
    tool = sys.argv[1]
    if tool not in TOOLS:
        print(f"❌ Unknown tool: {tool}")
        print(f"Available: {', '.join(TOOLS.keys())}")
        sys.exit(1)
    
    script_dir = Path(__file__).parent
    script_path = script_dir / TOOLS[tool]
    
    args = [sys.executable, str(script_path)] + sys.argv[2:]
    sys.exit(subprocess.run(args).returncode)

if __name__ == "__main__":
    main()
